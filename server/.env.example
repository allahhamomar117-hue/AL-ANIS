# =====================================================================
# الأنيس | متغيّرات الخادم
#
# انسخ هذا الملف إلى server/.env واملأ القيم. الملف الحقيقي لا يُرفع إلى
# Git — على Render أو Railway تُضاف هذه القيم في لوحة Environment.
# =====================================================================

# ── أساسيات ──────────────────────────────────────────────────────────
# المنفذ. على Render و Railway يُحقن تلقائياً، فاتركه دون ضبط هناك.
PORT=4000

# production يفعّل سجلّات مختصرة (combined) بدل سجلّات التطوير.
NODE_ENV=development


# ── قاعدة البيانات ───────────────────────────────────────────────────
# القاعدة SQLite في ملف واحد، والمسار نسبيّ إلى مجلد server.
#
# ⚠ هنا يفترق العالمان: لكل نسخة ملف قاعدة مستقلّ، فلا يمسح تعبئة
#   بيانات العرض سجلّات المسجد الحقيقية أبداً.
#
#   نسخة المسجد (Production): DB_FILE=data/anis.db
#   نسخة العرض  (Demo)      : DB_FILE=data/demo.db
DB_FILE=data/anis.db

# مجلد صور الطلاب المرفوعة.
UPLOADS_DIR=data/uploads


# ── المصادقة ─────────────────────────────────────────────────────────
# ⚠ إلزامي في الإنتاج: مفتاح توقيع رموز الدخول. من تركه على القيمة
#   الافتراضية جعل أي شخص قادراً على تزوير رمز دخول مدير.
#   ولّد واحداً: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   استعمل مفتاحاً مختلفاً لكل نسخة، حتى لا يفتح رمزُ العرض بابَ الإنتاج.
JWT_SECRET=change-me-in-production

# مدة صلاحية رمز الدخول.
JWT_EXPIRES_IN=30d


# ── CORS ─────────────────────────────────────────────────────────────
# النطاقات المسموح لها بمناداة الـ API، مفصولة بفواصل. يجب أن تتضمّن
# نطاق الواجهة المنشورة وإلا رفض المتصفّح كل الطلبات.
#
#   محلياً : http://localhost:5173,http://localhost:5174
#   العرض  : https://anis-demo.onrender.com
#   المسجد : https://anis.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174


# ── قواعد النقاط (اختيارية — لكلٍّ افتراضٌ في config.ts) ─────────────
# POINTS_ATTENDANCE=10
# POINTS_RECITATION_EXCELLENT=30
# POINTS_RECITATION_GOOD=25
# POINTS_RECITATION_NEEDS=20
# POINTS_RECITATION_MIN=5
