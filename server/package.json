{
  "name": "anis-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend و API لمشروع الأنيس",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-sql.mjs",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "user:role": "tsx src/db/setRole.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "db:seed-demo:prod": "node dist/db/seed-demo.js",
    "user:password": "tsx src/db/setPassword.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
