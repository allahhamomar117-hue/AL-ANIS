# =====================================================================
# الأنيس | متغيّرات الواجهة (Vite)
#
# انسخ هذا الملف إلى .env واملأ القيم. كل متغيّر تقرؤه الواجهة يجب أن
# يبدأ بـ VITE_ وإلا لن يصل إلى الشيفرة، وقيمته تُدمج في الملفات الثابتة
# وقت البناء — فلا تضع فيه أي سرّ (كلمات مرور، مفاتيح، روابط قواعد بيانات).
# =====================================================================

# ── التطوير المحلي ───────────────────────────────────────────────────
# اتركه فارغاً محلياً: تذهب الطلبات إلى /api ويمرّرها وسيط Vite.
VITE_API_BASE_URL=

# وجهة وسيط Vite في التطوير. غيّره فقط إن شغّلت الخادم على منفذ آخر.
# VITE_API_TARGET=http://localhost:4000


# ── الاستضافة (Render / Railway) ─────────────────────────────────────
# الواجهة تُنشر كموقع ثابت والخادم خدمة منفصلة، فلا وسيط بينهما.
# اضبط أصل الخادم كاملاً بلا شرطة مائلة في النهاية وبلا /api.
#
#   نسخة العرض : VITE_API_BASE_URL=https://anis-api-demo.onrender.com
#   نسخة المسجد: VITE_API_BASE_URL=https://anis-api.onrender.com
#
# أمر البناء : npm ci && npm run build
# مجلد النشر : dist
